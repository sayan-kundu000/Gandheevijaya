# ==============================================================================
# Gandheevijaya API - Environment Configuration Template
# Copy this file to .env and customize values for local development / deployment.
# NEVER commit the actual .env file or real production secrets to git!
# ==============================================================================

# Application Environment (development | testing | production)
APP_NAME="Gandheevijaya API"
PROJECT_NAME="GANDHEEVIJAYA"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# API Versioning Prefix
API_V1_STR=/api/v1

# Database Connection URL (PostgreSQL with psycopg3 driver for production)
# Example PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/gandheevijaya
# Example SQLite (local dev fallback): sqlite:///./gandheevijaya.db
DATABASE_URL=sqlite:///./gandheevijaya.db

# JWT Authentication Security Settings
# Generate a strong 256-bit key for production: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list or JSON array of frontend origins)
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
